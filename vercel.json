{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npx prisma generate && next build",
  "installCommand": "npm install",
  "devCommand": "next dev",
  "crons": [
    {
      "path": "/api/cron/release-escrow",
      "schedule": "17 3 * * *"
    },
    {
      "path": "/api/v2/cron/tick",
      "schedule": "23 3 * * *"
    }
  ]
}
