# ============================================
# Styra Environment Variables
# ============================================
# Copy this file to .env.local and fill in the values.
# NEVER commit real secrets to git.
# .env* is already in .gitignore.

# ── Application ────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Database ───────────────────────────────────────────────────────────
# Local development (SQLite) — overridden by shell environment in sandbox
DATABASE_URL=file:./db/custom.db
# Production (Supabase / PostgreSQL)
# DATABASE_URL=postgresql://user:password@host:5432/dbname?pgbouncer=true
# DIRECT_URL=postgresql://user:password@host:5432/dbname
# Fallback: Used when DATABASE_URL is SQLite (sandbox override) but PostgreSQL is needed
# SUPABASE_DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Authentication ─────────────────────────────────────────────────────
# JWT secret — must be at least 32 characters in production
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d
JWT_ISSUER=styra

# Admin account (used by /api/admin/cleanup to recreate admin)
ADMIN_EMAIL=admin@styra.app
ADMIN_PASSWORD=

# ── Supabase ───────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe ─────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── PayPal ─────────────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_SECRET=
PAYPAL_MODE=sandbox

# ── Paystack ───────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# ── M-Pesa (Safaricom Daraja) ─────────────────────────────────────────
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_ONLINE_PASSKEY=
MPESA_BUSINESS_SHORTCODE=
MPESA_ENV=sandbox
MPESA_CALLBACK_URL=
# MPESA_B2C_INITIATOR_NAME=test_api38

# ── Email (Resend) ─────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=Styra <noreply@yourdomain.com>

# ── Redis (for rate limiting) ─────────────────────────────────────────
# If not set, in-memory rate limiting is used as fallback
# REDIS_URL=redis://localhost:6379

# ── Cloudinary (image uploads) ─────────────────────────────────────────
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_URL=

# ── Pusher (real-time notifications) ──────────────────────────────────
# PUSHER_APP_ID=
# NEXT_PUBLIC_PUSHER_KEY=
# PUSHER_SECRET=
# NEXT_PUBLIC_PUSHER_CLUSTER=

# ── Web Push (VAPID) ──────────────────────────────────────────────────
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@styra.app

# ── OAuth (Social Login) ──────────────────────────────────────────────
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# NEXT_PUBLIC_APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=

# ── Rate Limiting ──────────────────────────────────────────────────────
# RATE_LIMIT_GLOBAL_RPM=200
# RATE_LIMIT_AUTH_MAX=5
# RATE_LIMIT_AUTH_WINDOW=900

# ── Security ───────────────────────────────────────────────────────────
# CRON_SECRET=
# CORS_ORIGINS=https://styra.app
# MAX_PAYLOAD_SIZE=1048576
# MAX_JSON_DEPTH=10
# MAX_OBJECT_KEYS=100
# MAX_STRING_LENGTH=100000
# TRUSTED_PROXIES=

# ── Vercel ─────────────────────────────────────────────────────────────
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=
